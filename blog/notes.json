---
layout: null
---
{% assign notes = site.notes | sort: 'date' | reverse %}
[
{% for note in notes %}
  {
    "title": {{ note.title | jsonify }},
    "date": {{ note.date | date: '%Y-%m-%d' | jsonify }},
    "topic": {{ note.topic | jsonify }},
    "kind": {{ note.kind | default: 'Note' | jsonify }},
    "excerpt": {{ note.excerpt | jsonify }},
    "body": {{ note.content | strip_html | normalize_whitespace | jsonify }},
    "url": {{ note.url | relative_url | jsonify }},
    "image": {% if note.image and note.image != '' %}{{ note.image | relative_url | jsonify }}{% else %}""{% endif %},
    "imageAlt": {{ note.image_alt | default: '' | jsonify }}
  }{% unless forloop.last %},{% endunless %}
{% endfor %}
]
